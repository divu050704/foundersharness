<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="520"
        Width="720" Height="520"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        x:Class="foundersharness.MainWindow"
        Title="foundersharness Dev Helper"
        Background="#121210"
        Foreground="#edeae2"

        >

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#2c2c27" />
            <Setter Property="Foreground" Value="#edeae2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12 8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3c3c35" />
            <Setter Property="Foreground" Value="#edeae2" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#4a6b4e" />
            <Setter Property="Foreground" Value="#121210" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#5b8260" />
            <Setter Property="Foreground" Value="#121210" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#a33a3a" />
            <Setter Property="Foreground" Value="#edeae2" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#b84545" />
            <Setter Property="Foreground" Value="#edeae2" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="BorderBrush" Value="#2c2c27"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#4a6b4e" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Styles>

    <Grid>
        <!-- Main Application Panel -->
        <Grid RowDefinitions="Auto, Auto, *" Margin="20">
            <!-- 1. Header Area -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0 0 0 15">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="FOUNDERSHARNESS DEV HELPER" FontSize="18" FontWeight="Bold" Foreground="#edeae2" LetterSpacing="1" />
                    <TextBlock Text="Browser Bridge &amp; WebSocket Controller" FontSize="11" Foreground="#8c897e" Margin="0 2 0 0" />
                </StackPanel>
                
                <Button Grid.Column="1" Content="Hide to Tray" Click="OnHideClick" VerticalAlignment="Center" />
            </Grid>

            <!-- Divider -->
            <Border Grid.Row="1" Height="1" Background="#2c2c27" Margin="0 0 0 15"/>

            <!-- 2. Main Content Grid -->
            <Grid Grid.Row="2" ColumnDefinitions="*, 200" Margin="0">
                <!-- Left: Logs Section -->
                <Grid Grid.Column="0" RowDefinitions="Auto, *" Margin="0 0 15 0">
                    <TextBlock Grid.Row="0" Text="DEBUG LOGS" FontSize="11" FontWeight="Bold" Foreground="#8c897e" Margin="0 0 0 8" LetterSpacing="0.5"/>
                    <TextBox Grid.Row="1" Name="TxtLogs" 
                             Background="#1b1b18" 
                             Foreground="#edeae2" 
                             FontFamily="Consolas, Menlo, Monaco, monospace" 
                             FontSize="12"
                             IsReadOnly="True" 
                             AcceptsReturn="True" 
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top" />
                </Grid>

                <!-- Right: Control Panel & Status -->
                <StackPanel Grid.Column="1" Spacing="15">
                    <!-- Status Cards -->
                    <Border Background="#1b1b18" BorderBrush="#2c2c27" BorderThickness="1" CornerRadius="4" Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="#8c897e" LetterSpacing="0.5" />
                            
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Name="ElServerStatus" Width="8" Height="8" Fill="#a33a3a" VerticalAlignment="Center" />
                                <TextBlock Name="LblServerStatus" Text="Server: Stopped" FontSize="12" FontWeight="SemiBold" Foreground="#edeae2"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Name="ElBrowserStatus" Width="8" Height="8" Fill="#a33a3a" VerticalAlignment="Center" />
                                <TextBlock Name="LblBrowserStatus" Text="Browser: Closed" FontSize="12" FontWeight="SemiBold" Foreground="#edeae2"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Actions Panel -->
                    <Border Background="#1b1b18" BorderBrush="#2c2c27" BorderThickness="1" CornerRadius="4" Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="CONTROLS" FontSize="11" FontWeight="Bold" Foreground="#8c897e" LetterSpacing="0.5" />
                            
                            <Button Name="BtnToggleServer" Content="Start Server" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnToggleServerClick"/>
                            <Button Name="BtnToggleBrowser" Classes="primary" Content="Launch Browser" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnToggleBrowserClick"/>
                            <Button Name="BtnInstallPlaywright" Content="Install Playwright" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnInstallPlaywrightClick"/>
                            <Button Content="Clear Logs" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnClearLogsClick"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 3. Installer Overlay Panel (Setup Wizard) -->
        <Grid Name="PnlInstaller" Background="#121210" IsVisible="False" RowDefinitions="Auto, Auto, Auto, *" Margin="30">
            <TextBlock Grid.Row="0" Text="foundersharness Setup Wizard" FontSize="20" FontWeight="Bold" Foreground="#edeae2" Margin="0 0 0 10"/>
            <TextBlock Grid.Row="1" Name="LblInstallStatus" Text="Playwright browser engines are missing. Starting automatic setup..." FontSize="13" Foreground="#8c897e" Margin="0 0 0 20"/>
            
            <StackPanel Grid.Row="2" Margin="0 0 0 15">
                <ProgressBar Name="PrgInstall" Height="8" Background="#2c2c27" Foreground="#4a6b4e" Margin="0 0 0 8" Minimum="0" Maximum="100"/>
                <TextBlock Name="LblInstallDetails" Text="Preparing installation..." FontSize="11" FontFamily="Consolas" Foreground="#8c897e" />
            </StackPanel>

            <TextBox Grid.Row="3" Name="TxtInstallLogs" 
                     Background="#1b1b18" 
                     Foreground="#edeae2" 
                     FontFamily="Consolas, Menlo, Monaco, monospace" 
                     FontSize="11"
                     IsReadOnly="True" 
                     AcceptsReturn="True" 
                     TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
